              "});",
              "pm.test('list has pagination shape', function () {",
              "  const body = pm.response.json();",
              "  pm.expect(body.data.items).to.be.an('array');",
              "  pm.expect(body.data.page).to.equal(1);",
              "  pm.expect(body.data.limit).to.equal(20);",
              "});",
              "const body = pm.response.json();",
              "const customer = body.data.items.find((item) => item.email === pm.collectionVariables.get('customerEmail'));",
              "if (customer) {",
              "  pm.collectionVariables.set('customerId', customer.id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/admin/customers?page=1&limit=20",
          "host": [
