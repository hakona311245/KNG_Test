    {
      "name": "01 Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}",
          "host": [
            "{{baseUrl}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('returns Hello World', function () {",
              "  pm.expect(pm.response.text()).to.equal('Hello World!');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Register Customer",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.collectionVariables.get('customerEmail')) {",
              "  pm.collectionVariables.set('customerEmail', `customer-${Date.now()}@example.com`);",
              "}",
              "if (!pm.collectionVariables.get('customerPassword')) {",
              "  pm.collectionVariables.set('customerPassword', 'Password123');",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 201', function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "const body = pm.response.json();",
              "pm.test('register returns customer', function () {",
              "  pm.expect(body.data.email).to.equal(pm.collectionVariables.get('customerEmail'));",
              "  pm.expect(body.data.role).to.equal('CUSTOMER');",
              "  pm.expect(body.data.status).to.equal('ACTIVE');",
              "});",
              "pm.collectionVariables.set('customerId', body.data.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"fullName\": \"Postman Customer\",\n  \"password\": \"{{customerPassword}}\",\n  \"phoneNumber\": \"0900000000\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "register"
          ]
        }
      }
    },
