{
  "info": {
    "_postman_id": "64f71b7f-6e7c-40da-b1d4-3b87d2710f87",
    "name": "KNG Fashion - Product",
    "description": "Manual Postman checks for implemented Product backend endpoints. Run requests in order. Admin requests use Postman's cookie jar after admin login.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api"
    },
    {
      "key": "adminEmail",
      "value": "admin@kng-fashion.local"
    },
    {
      "key": "adminPassword",
      "value": "AdminPassword123"
    },
    {
      "key": "productName",
      "value": ""
    },
    {
      "key": "productId",
      "value": ""
    },
    {
      "key": "variantId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}",
          "host": [
            "{{baseUrl}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('returns current health text', function () {",
              "  pm.expect(pm.response.text()).to.equal('KNG_FASHION WORKED!');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Admin Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('login returns admin user', function () {",
              "  const body = pm.response.json();",
              "  pm.expect(body.data.user.role).to.equal('ADMIN');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Create Product",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"{{productName}}\",\n  \"description\": \"Daily cotton shirt created from Postman\",\n  \"type\": \"SHIRT\",\n  \"material\": \"Cotton\",\n  \"price\": 250000,\n  \"imageUrl\": \"https://example.com/placeholder.jpg\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/admin/products",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "admin",
            "products"
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.collectionVariables.get('productName')) {",
              "  pm.collectionVariables.set('productName', `Postman Shirt ${Date.now()}`);",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 201', function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "const body = pm.response.json();",
              "pm.test('product created', function () {",
              "  pm.expect(body.message).to.equal('Product created successfully');",
              "  pm.expect(body.data.name).to.equal(pm.collectionVariables.get('productName'));",
              "  pm.expect(body.data.type).to.equal('SHIRT');",
              "});",
              "pm.collectionVariables.set('productId', body.data.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "04 List Admin Products",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/admin/products?type=SHIRT&page=1&limit=20",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "admin",
            "products"
          ],
          "query": [
            {
              "key": "type",
              "value": "SHIRT"
            },
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "20"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('admin product list has pagination shape', function () {",
              "  const body = pm.response.json();",
              "  pm.expect(body.message).to.equal('Products retrieved successfully');",
              "  pm.expect(body.data.items).to.be.an('array');",
              "  pm.expect(body.data.page).to.equal(1);",
              "  pm.expect(body.data.limit).to.equal(20);",
              "});"
            ]
          }
        }
      ]
    },
