              "});",
              "const body = pm.response.json();",
              "pm.test('variant created', function () {",
              "  pm.expect(body.message).to.equal('Product variant created successfully');",
              "  pm.expect(body.data.size).to.equal('M');",
              "  pm.expect(body.data.color).to.equal('Black');",
              "});",
              "pm.collectionVariables.set('variantId', body.data.id);"
            ]
          }
        }
