    {
      "name": "07 Duplicate Variant Check",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"size\": \"M\",\n  \"color\": \"Black\",\n  \"stock\": 10\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/admin/products/{{productId}}/variants",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "admin",
            "products",
            "{{productId}}",
            "variants"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 409', function () {",
              "  pm.response.to.have.status(409);",
              "});",
              "pm.test('duplicate variant message is correct', function () {",
              "  pm.expect(pm.response.json().message).to.equal('Product variant with this size and color already exists.');",
              "});"
            ]
          }
        }
      ]
