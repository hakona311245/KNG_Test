DATABASE_URL="postgresql://kng_user:kng_password@localhost:5433/kng_fashion?schema=public"
PORT="3000"
FRONTEND_URL="http://localhost:5173"
FRONTEND_URLS="http://localhost:5173,http://localhost:5174"

JWT_ACCESS_SECRET="replace-with-at-least-16-character-access-secret"
JWT_REFRESH_SECRET="replace-with-at-least-16-character-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
COOKIE_SECURE="false"
COOKIE_SAME_SITE="lax"

ADMIN_EMAIL="admin@kng-fashion.local"
ADMIN_PASSWORD="AdminPassword123"
ADMIN_FULL_NAME="KNG Admin"
ADMIN_PHONE_NUMBER="0900000000"

CLOUDINARY_URL="cloudinary://replace-with-api-key:replace-with-api-secret@replace-with-cloud-name"
CLOUDINARY_FOLDER="kng-fashion/products"

# Alternative to CLOUDINARY_URL:
# CLOUDINARY_CLOUD_NAME="replace-with-cloudinary-cloud-name"
# CLOUDINARY_API_KEY="replace-with-cloudinary-api-key"
# CLOUDINARY_API_SECRET="replace-with-cloudinary-api-secret"
